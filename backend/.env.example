# Copy this file to backend/.env and fill in ONE provider block.
# .env is git-ignored — your keys never leave this machine.

LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here

# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here

# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your-key-here

# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-your-key-here

# JWT signing secret — change to any long random string
PROMPTINEERING_SECRET=replace-with-a-long-random-string
